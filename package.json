{
  "name": "@ai-pages/ui-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Storybook viewer for the project's original HTML components.",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "storybook": "node scripts/storybook.mjs dev --host 127.0.0.1 --port 6006 --no-open --no-version-updates",
    "build-storybook": "node scripts/storybook.mjs build --output-dir dist",
    "check:core": "node scripts/check-core.mjs",
    "core:baseline": "node scripts/update-core-baseline.mjs",
    "css:build": "node scripts/css-rebuild.mjs build",
    "css:apply": "node scripts/css-rebuild.mjs apply",
    "css:clean": "node scripts/css-rebuild.mjs clean"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.0",
    "@storybook/html-vite": "10.6.0",
    "cally": "0.9.2",
    "storybook": "10.6.0",
    "vanilla-calendar-pro": "3.4.0",
    "vite": "8.3.1"
  }
}
